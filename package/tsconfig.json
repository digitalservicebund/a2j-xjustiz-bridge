{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    /*
     * **ATTENTION:**
     * We try to be as runtime environment agnostic as possible. Any requirement
     * MUST be communicated to the user in the documentation!
     *
     * For global type declarations, add new entries with great care. The
     * baseline is based on the A2J Platform. Extensions should picked explicitly
     * without adding the full libraries. Like don't just add `ESNext` or `DOM`.
     * For the global object, do not add any entry, but explicitly declare them
     * in the `global.d.ts` file.
     */
    "lib": ["ES2024", "ESNext.Temporal"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "types": ["vitest/importMeta"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["./src/", "./test/"]
}
